{
  "name": "api-shadow",
  "displayName": "API Shadow",
  "description": "See every API endpoint in Express, Fastify, Koa, NestJS and Spring Boot, and what calls it: change impact on frontend code, OpenAPI contract diffs, a security radar, a dependency graph and generated tests. Fully local.",
  "version": "0.4.0",
  "publisher": "OmairSaad",
  "license": "MIT",
  "author": {
    "name": "OmairSaad"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OmairSaad/api-shadow.git"
  },
  "homepage": "https://github.com/OmairSaad/api-shadow#readme",
  "bugs": {
    "url": "https://github.com/OmairSaad/api-shadow/issues"
  },
  "pricing": "Free",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1e1b2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "api",
    "endpoints",
    "routes",
    "express",
    "nestjs",
    "spring",
    "spring boot",
    "openapi",
    "rest",
    "curl",
    "http",
    "security",
    "codelens",
    "rest client",
    "fastify",
    "koa",
    "breaking changes",
    "fetch",
    "axios",
    "impact analysis",
    "dependency graph",
    "test generation",
    "api contract"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/pom.xml",
    "workspaceContains:**/build.gradle",
    "workspaceContains:**/build.gradle.kts"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "API Shadow only reads source files and never executes workspace code. Comparing with git revisions (API diff, OpenAPI contract comparison and the git HEAD impact baseline) runs git, so it needs a trusted workspace; impact analysis falls back to the session start otherwise."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "API Shadow resolves imports using local file paths."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apiShadow",
          "title": "API Shadow",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "apiShadow": [
        {
          "id": "apiShadow.endpoints",
          "name": "Endpoints",
          "icon": "resources/activity.svg",
          "contextualTitle": "API Shadow"
        },
        {
          "id": "apiShadow.issues",
          "name": "Issues",
          "icon": "resources/activity.svg",
          "contextualTitle": "API Shadow"
        },
        {
          "id": "apiShadow.security",
          "name": "Security",
          "icon": "resources/activity.svg",
          "contextualTitle": "API Shadow",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "apiShadow.endpoints",
        "contents": "Open a folder that contains an Express, Fastify, Koa, NestJS or Spring Boot project to discover its API endpoints.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "apiShadow.endpoints",
        "contents": "Analyzing workspace for API endpoints…",
        "when": "workbenchState != empty && !apiShadow.ready"
      },
      {
        "view": "apiShadow.endpoints",
        "contents": "No API endpoints were found.\nAPI Shadow supports Express, Fastify, Koa, NestJS and Spring Boot (Java). Check the Issues view for files that could not be analyzed.\n[Refresh](command:apiShadow.refresh)\n[Show Log](command:apiShadow.showLog)",
        "when": "workbenchState != empty && apiShadow.ready && !apiShadow.hasEndpoints"
      },
      {
        "view": "apiShadow.issues",
        "contents": "No duplicate routes or analysis limitations.",
        "when": "apiShadow.ready"
      },
      {
        "view": "apiShadow.security",
        "contents": "No security findings. API Shadow checks for hardcoded credentials, permissive CORS, routes without recognizable auth, mass assignment, injection, open redirects, file paths from request input, exposed error details and sensitive response fields. It cannot prove an API is secure.\n[Open Dashboard](command:apiShadow.showDashboard)",
        "when": "apiShadow.ready"
      }
    ],
    "commands": [
      {
        "command": "apiShadow.refresh",
        "title": "Refresh Endpoints",
        "category": "API Shadow",
        "icon": "$(refresh)"
      },
      {
        "command": "apiShadow.search",
        "title": "Search Endpoints",
        "category": "API Shadow",
        "icon": "$(search)"
      },
      {
        "command": "apiShadow.filter",
        "title": "Filter Endpoints by Text",
        "category": "API Shadow",
        "icon": "$(filter)"
      },
      {
        "command": "apiShadow.filterByMethod",
        "title": "Filter by HTTP Method",
        "category": "API Shadow",
        "icon": "$(symbol-event)"
      },
      {
        "command": "apiShadow.clearFilter",
        "title": "Clear Filters",
        "category": "API Shadow",
        "icon": "$(clear-all)"
      },
      {
        "command": "apiShadow.groupBy",
        "title": "Group Endpoints By…",
        "category": "API Shadow",
        "icon": "$(list-tree)"
      },
      {
        "command": "apiShadow.exportMarkdown",
        "title": "Export Endpoints to Markdown",
        "category": "API Shadow",
        "icon": "$(markdown)"
      },
      {
        "command": "apiShadow.exportOpenApi",
        "title": "Export Endpoints to OpenAPI 3.0 (JSON)",
        "category": "API Shadow",
        "icon": "$(json)"
      },
      {
        "command": "apiShadow.exportHttp",
        "title": "Export Endpoints to .http Requests",
        "category": "API Shadow",
        "icon": "$(globe)"
      },
      {
        "command": "apiShadow.clearCache",
        "title": "Clear Analysis Cache and Re-analyze",
        "category": "API Shadow"
      },
      {
        "command": "apiShadow.showLog",
        "title": "Show Log",
        "category": "API Shadow"
      },
      {
        "command": "apiShadow.openLocation",
        "title": "Open Source Location",
        "category": "API Shadow"
      },
      {
        "command": "apiShadow.openHandler",
        "title": "Go to Handler",
        "category": "API Shadow",
        "icon": "$(go-to-file)"
      },
      {
        "command": "apiShadow.copyPath",
        "title": "Copy Path",
        "category": "API Shadow",
        "icon": "$(copy)"
      },
      {
        "command": "apiShadow.copyMethodAndPath",
        "title": "Copy Method and Path",
        "category": "API Shadow"
      },
      {
        "command": "apiShadow.copyCurl",
        "title": "Copy as cURL",
        "category": "API Shadow",
        "icon": "$(terminal)"
      },
      {
        "command": "apiShadow.openRequest",
        "title": "Open as HTTP Request",
        "category": "API Shadow",
        "icon": "$(play)"
      },
      {
        "command": "apiShadow.endpointActions",
        "title": "Endpoint Actions",
        "category": "API Shadow"
      },
      {
        "command": "apiShadow.showFlow",
        "title": "Show Request Flow",
        "category": "API Shadow",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "apiShadow.showCallers",
        "title": "Show Callers",
        "category": "API Shadow",
        "icon": "$(references)"
      },
      {
        "command": "apiShadow.compareWithRef",
        "title": "Compare API with Branch or Tag…",
        "category": "API Shadow",
        "icon": "$(git-compare)"
      },
      {
        "command": "apiShadow.showDashboard",
        "title": "Open Dashboard",
        "category": "API Shadow",
        "icon": "$(dashboard)"
      },
      {
        "command": "apiShadow.showGraph",
        "title": "Show Dependency Graph",
        "category": "API Shadow",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "apiShadow.analyzeImpact",
        "title": "Analyze Change Impact",
        "category": "API Shadow",
        "icon": "$(pulse)"
      },
      {
        "command": "apiShadow.setImpactBaseline",
        "title": "Set Impact Baseline…",
        "category": "API Shadow"
      },
      {
        "command": "apiShadow.compareContracts",
        "title": "Compare API Contracts (OpenAPI)…",
        "category": "API Shadow",
        "icon": "$(diff)"
      },
      {
        "command": "apiShadow.generateTests",
        "title": "Generate API Tests…",
        "category": "API Shadow",
        "icon": "$(beaker)"
      },
      {
        "command": "apiShadow.runSecurityAnalysis",
        "title": "Run Security Analysis",
        "category": "API Shadow",
        "icon": "$(shield)"
      },
      {
        "command": "apiShadow.exportReport",
        "title": "Export Analysis Report",
        "category": "API Shadow",
        "icon": "$(output)"
      },
      {
        "command": "apiShadow.exportGraph",
        "title": "Export Dependency Graph…",
        "category": "API Shadow"
      },
      {
        "command": "apiShadow.dismissFinding",
        "title": "Dismiss Finding",
        "category": "API Shadow"
      },
      {
        "command": "apiShadow.dismissFindingFromTree",
        "title": "Dismiss Finding",
        "category": "API Shadow",
        "icon": "$(eye-closed)"
      },
      {
        "command": "apiShadow.restoreFinding",
        "title": "Restore Finding",
        "category": "API Shadow",
        "icon": "$(eye)"
      },
      {
        "command": "apiShadow.restoreDismissedFindings",
        "title": "Restore Dismissed Security Findings",
        "category": "API Shadow"
      },
      {
        "command": "apiShadow.disableSecurityRule",
        "title": "Turn Off Security Rule…",
        "category": "API Shadow"
      },
      {
        "command": "apiShadow.enableSecurityRule",
        "title": "Turn On Security Rule",
        "category": "API Shadow"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "apiShadow.showDashboard",
          "when": "view == apiShadow.endpoints",
          "group": "navigation@0"
        },
        {
          "command": "apiShadow.search",
          "when": "view == apiShadow.endpoints",
          "group": "navigation@1"
        },
        {
          "command": "apiShadow.filter",
          "when": "view == apiShadow.endpoints",
          "group": "navigation@2"
        },
        {
          "command": "apiShadow.filterByMethod",
          "when": "view == apiShadow.endpoints",
          "group": "navigation@3"
        },
        {
          "command": "apiShadow.clearFilter",
          "when": "view == apiShadow.endpoints && apiShadow.filtered",
          "group": "navigation@4"
        },
        {
          "command": "apiShadow.groupBy",
          "when": "view == apiShadow.endpoints",
          "group": "navigation@5"
        },
        {
          "command": "apiShadow.refresh",
          "when": "view == apiShadow.endpoints",
          "group": "navigation@6"
        },
        {
          "command": "apiShadow.compareWithRef",
          "when": "view == apiShadow.endpoints",
          "group": "compare@1"
        },
        {
          "command": "apiShadow.exportMarkdown",
          "when": "view == apiShadow.endpoints",
          "group": "export@1"
        },
        {
          "command": "apiShadow.exportOpenApi",
          "when": "view == apiShadow.endpoints",
          "group": "export@2"
        },
        {
          "command": "apiShadow.exportHttp",
          "when": "view == apiShadow.endpoints",
          "group": "export@3"
        },
        {
          "command": "apiShadow.clearCache",
          "when": "view == apiShadow.endpoints",
          "group": "maintenance@1"
        },
        {
          "command": "apiShadow.showLog",
          "when": "view == apiShadow.endpoints",
          "group": "maintenance@2"
        },
        {
          "command": "apiShadow.refresh",
          "when": "view == apiShadow.issues",
          "group": "navigation@1"
        },
        {
          "command": "apiShadow.analyzeImpact",
          "when": "view == apiShadow.endpoints",
          "group": "intel@1"
        },
        {
          "command": "apiShadow.compareContracts",
          "when": "view == apiShadow.endpoints",
          "group": "intel@2"
        },
        {
          "command": "apiShadow.generateTests",
          "when": "view == apiShadow.endpoints",
          "group": "intel@3"
        },
        {
          "command": "apiShadow.showGraph",
          "when": "view == apiShadow.endpoints",
          "group": "intel@4"
        },
        {
          "command": "apiShadow.exportReport",
          "when": "view == apiShadow.endpoints",
          "group": "export@0"
        },
        {
          "command": "apiShadow.runSecurityAnalysis",
          "when": "view == apiShadow.security",
          "group": "navigation@1"
        },
        {
          "command": "apiShadow.showDashboard",
          "when": "view == apiShadow.security",
          "group": "navigation@2"
        },
        {
          "command": "apiShadow.restoreDismissedFindings",
          "when": "view == apiShadow.security",
          "group": "more@1"
        },
        {
          "command": "apiShadow.disableSecurityRule",
          "when": "view == apiShadow.security",
          "group": "more@2"
        }
      ],
      "view/item/context": [
        {
          "command": "apiShadow.openRequest",
          "when": "view == apiShadow.endpoints && viewItem == apiShadow.endpoint",
          "group": "inline@0"
        },
        {
          "command": "apiShadow.openHandler",
          "when": "view == apiShadow.endpoints && viewItem == apiShadow.endpoint",
          "group": "inline@1"
        },
        {
          "command": "apiShadow.copyPath",
          "when": "view == apiShadow.endpoints && viewItem == apiShadow.endpoint",
          "group": "inline@2"
        },
        {
          "command": "apiShadow.openHandler",
          "when": "view == apiShadow.endpoints && viewItem == apiShadow.endpoint",
          "group": "1_navigation@1"
        },
        {
          "command": "apiShadow.copyPath",
          "when": "view == apiShadow.endpoints && viewItem == apiShadow.endpoint",
          "group": "2_copy@1"
        },
        {
          "command": "apiShadow.copyMethodAndPath",
          "when": "view == apiShadow.endpoints && viewItem == apiShadow.endpoint",
          "group": "2_copy@2"
        },
        {
          "command": "apiShadow.openRequest",
          "when": "view == apiShadow.endpoints && viewItem == apiShadow.endpoint",
          "group": "1_navigation@2"
        },
        {
          "command": "apiShadow.copyCurl",
          "when": "view == apiShadow.endpoints && viewItem == apiShadow.endpoint",
          "group": "2_copy@3"
        },
        {
          "command": "apiShadow.showFlow",
          "when": "view == apiShadow.endpoints && viewItem == apiShadow.endpoint",
          "group": "1_navigation@3"
        },
        {
          "command": "apiShadow.showCallers",
          "when": "view == apiShadow.endpoints && viewItem == apiShadow.endpoint",
          "group": "1_navigation@4"
        },
        {
          "command": "apiShadow.generateTests",
          "when": "view == apiShadow.endpoints && viewItem == apiShadow.endpoint",
          "group": "3_generate@1"
        },
        {
          "command": "apiShadow.dismissFindingFromTree",
          "when": "view == apiShadow.security && viewItem == apiShadow.finding",
          "group": "inline@1"
        },
        {
          "command": "apiShadow.restoreFinding",
          "when": "view == apiShadow.security && viewItem == apiShadow.dismissedFinding",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "apiShadow.openLocation",
          "when": "false"
        },
        {
          "command": "apiShadow.openHandler",
          "when": "false"
        },
        {
          "command": "apiShadow.copyPath",
          "when": "false"
        },
        {
          "command": "apiShadow.copyMethodAndPath",
          "when": "false"
        },
        {
          "command": "apiShadow.clearFilter",
          "when": "apiShadow.filtered"
        },
        {
          "command": "apiShadow.endpointActions",
          "when": "false"
        },
        {
          "command": "apiShadow.dismissFinding",
          "when": "false"
        },
        {
          "command": "apiShadow.dismissFindingFromTree",
          "when": "false"
        },
        {
          "command": "apiShadow.restoreFinding",
          "when": "false"
        },
        {
          "command": "apiShadow.enableSecurityRule",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "API Shadow",
      "properties": {
        "apiShadow.frameworks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "express",
              "fastify",
              "koa",
              "nestjs",
              "spring"
            ]
          },
          "default": [
            "express",
            "fastify",
            "koa",
            "nestjs",
            "spring"
          ],
          "uniqueItems": true,
          "description": "Frameworks to detect."
        },
        "apiShadow.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Additional glob patterns (relative to the workspace folder) to exclude from analysis, e.g. `**/legacy/**`. `node_modules`, build outputs and `.git` are always excluded."
        },
        "apiShadow.includeTestFiles": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Treat test files (`*.spec.ts`, `*.test.js`, `__tests__/`, `test/`, `src/test/`) like other sources, so routes declared in them are shown as endpoints."
        },
        "apiShadow.respectFilesExclude": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Also skip files matched by `#files.exclude#`."
        },
        "apiShadow.maxFiles": {
          "type": "number",
          "default": 20000,
          "minimum": 100,
          "description": "Maximum number of candidate source files to analyze. Larger workspaces are truncated and a warning is shown."
        },
        "apiShadow.maxFileSizeKB": {
          "type": "number",
          "default": 512,
          "minimum": 16,
          "description": "Files larger than this (in KB) are skipped, which usually excludes generated or bundled code."
        },
        "apiShadow.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Re-analyze automatically when relevant files change."
        },
        "apiShadow.refreshDebounceMs": {
          "type": "number",
          "default": 800,
          "minimum": 100,
          "description": "Delay after the last file change before re-analyzing."
        },
        "apiShadow.groupBy": {
          "type": "string",
          "enum": [
            "controller",
            "file",
            "method",
            "framework",
            "path",
            "none"
          ],
          "enumDescriptions": [
            "Controller class or router file",
            "Source file",
            "HTTP method",
            "Framework",
            "First path segment",
            "Flat list"
          ],
          "default": "controller",
          "description": "Default grouping of the Endpoints view."
        },
        "apiShadow.diagnostics.duplicates": {
          "type": "boolean",
          "default": true,
          "description": "Report potential duplicate routes in the Problems panel."
        },
        "apiShadow.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the endpoint count in the status bar."
        },
        "apiShadow.spring.applyContextPath": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Prefix Spring endpoints with `server.servlet.context-path` / `spring.mvc.servlet.path` from `application.properties` / `application.yml`."
        },
        "apiShadow.persistCache": {
          "type": "boolean",
          "default": true,
          "description": "Persist per-file analysis results between sessions (stored in VS Code workspace storage) to speed up startup."
        },
        "apiShadow.export.includeSourceLocations": {
          "type": "boolean",
          "default": true,
          "description": "Include source file paths and line numbers in Markdown and OpenAPI exports."
        },
        "apiShadow.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show method, path, auth and request actions (**Try it**, **cURL**) above each endpoint declaration."
        },
        "apiShadow.auth.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Detect whether endpoints are protected by auth middleware, guards or security annotations."
        },
        "apiShadow.auth.warnings": {
          "type": "string",
          "enum": [
            "sensitive",
            "all",
            "off"
          ],
          "enumDescriptions": [
            "Write endpoints (POST, PUT, PATCH, DELETE) and admin or internal paths",
            "Every endpoint",
            "No warnings; auth is still shown"
          ],
          "default": "sensitive",
          "markdownDescription": "Which endpoints without auth to report in the Issues view. Only projects where other endpoints have auth are reported, and sign-in, webhook, health and documentation paths never are."
        },
        "apiShadow.auth.patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "auth",
            "jwt",
            "bearer",
            "token",
            "api[-_]?key",
            "logged[-_]?in",
            "signed[-_]?in",
            "require[-_]?(user|login|session)",
            "role",
            "permission",
            "admin",
            "protect",
            "^(UseGuards|APP_GUARD|useGlobalGuards)\\((?!.*(throttl|ratelimit))",
            "Secured",
            "RolesAllowed",
            "DenyAll"
          ],
          "markdownDescription": "Case-insensitive regular expressions matched against middleware, guards, security annotations and decorators (e.g. `UseGuards(JwtAuthGuard)`, `requireAuth`). A match marks the endpoint as protected. Add your own auth middleware names here."
        },
        "apiShadow.auth.publicPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "@Public\\b",
            "@(Allow)?Anonymous\\b",
            "@(Skip|No)Auth\\b",
            "@IsPublic\\b",
            "PermitAll",
            "permitAll\\(\\)",
            "isAnonymous\\(\\)"
          ],
          "markdownDescription": "Case-insensitive regular expressions for explicit opt-outs such as `@Public()` or `@PermitAll`. They win over `#apiShadow.auth.patterns#`."
        },
        "apiShadow.requests.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL for **Try it**, **Copy as cURL** and `.http` exports, e.g. `https://staging.example.com`. When empty, `http://localhost:<port>` is used with the port from `app.listen()` or `server.port`, falling back to 3000 (Express, Fastify, Koa, NestJS) or 8080 (Spring)."
        },
        "apiShadow.unreachable.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Report routes that can never run because a route registered earlier on the same router matches every request they would get (Express, Koa, NestJS), e.g. `GET /users/:id` declared before `GET /users/me`."
        },
        "apiShadow.diagnostics.unreachable": {
          "type": "boolean",
          "default": true,
          "description": "Show unreachable routes in the Problems panel."
        },
        "apiShadow.clientCalls.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Find HTTP calls in frontend and test code (`fetch`, axios, ky, Angular `HttpClient`, supertest, MockMvc) and link them to endpoints: go to definition, hovers, caller counts and calls to missing routes."
        },
        "apiShadow.clientCalls.reportUncalled": {
          "type": "boolean",
          "default": false,
          "description": "List endpoints that no code in the workspace calls in the Issues view (only for projects whose endpoints are called from somewhere)."
        },
        "apiShadow.diagnostics.brokenCalls": {
          "type": "boolean",
          "default": true,
          "description": "Underline calls to routes that do not exist in the Problems panel."
        },
        "apiShadow.tests.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Read test files for endpoint test coverage. Routes declared in tests are not shown unless `#apiShadow.includeTestFiles#` is on."
        },
        "apiShadow.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Detect whether request bodies are validated (validation middleware, schema checks, NestJS pipes, @Valid, Fastify schemas) and report unvalidated ones in projects that validate others."
        },
        "apiShadow.respectGitignore": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Also skip files matched by the `.gitignore` at the root of each workspace folder. Negated patterns (`!pattern`) and nested `.gitignore` files are not applied."
        },
        "apiShadow.responseChecks.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Report client code that reads a response field the endpoint does not return, when the response shape is known (built from literals or a declared DTO type)."
        },
        "apiShadow.diagnostics.responseMismatch": {
          "type": "boolean",
          "default": true,
          "description": "Show reads of missing response fields in the Problems panel."
        },
        "apiShadow.impact.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Analyze the impact of API changes: compare the current code with a baseline (see `#apiShadow.impact.baseline#`) and find the client code that reads removed, renamed or retyped response fields or calls changed routes."
        },
        "apiShadow.impact.baseline": {
          "type": "string",
          "enum": [
            "gitHead",
            "session"
          ],
          "enumDescriptions": [
            "The last commit (HEAD): the impact of uncommitted changes. Needs git and a trusted workspace; falls back to the session start otherwise.",
            "The first analysis of this VS Code session."
          ],
          "default": "gitHead",
          "markdownDescription": "What the current code is compared with for change impact. **API Shadow: Set Impact Baseline…** can also choose a branch, tag or the current state."
        },
        "apiShadow.diagnostics.impact": {
          "type": "boolean",
          "default": true,
          "description": "Show potential breaking changes at the affected client code and at the changed endpoint in the Problems panel."
        },
        "apiShadow.security.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the Security Radar: static checks for API-related risks. Nothing is executed or sent anywhere."
        },
        "apiShadow.security.disabledRules": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hardcoded-secret",
              "sensitive-response",
              "missing-auth",
              "permissive-cors",
              "mass-assignment",
              "object-authorization",
              "injection",
              "open-redirect",
              "path-traversal",
              "error-details",
              "config-exposure"
            ]
          },
          "default": [],
          "uniqueItems": true,
          "description": "Security rules to skip."
        },
        "apiShadow.security.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Glob patterns (relative to the workspace folder) of files that get no security findings, e.g. `**/fixtures/**`."
        },
        "apiShadow.diagnostics.security": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "off"
          ],
          "enumDescriptions": [
            "High severity only",
            "Medium and high",
            "All findings",
            "None (findings are still listed in the Security view)"
          ],
          "default": "high",
          "description": "Lowest severity of security findings shown in the Problems panel."
        },
        "apiShadow.contracts.files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra glob patterns for OpenAPI 3 documents to compare. Files named `openapi.*`, `swagger.*`, `api.*`, `*.openapi.*` and files in `openapi/` or `specs/` folders are found automatically."
        },
        "apiShadow.graph.maxEndpoints": {
          "type": "number",
          "default": 150,
          "minimum": 10,
          "maximum": 5000,
          "description": "Maximum number of endpoints drawn in the dependency graph (the most connected first). Use the graph's focus search to see others."
        },
        "apiShadow.testGeneration.directory": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder for generated test files, relative to the project root (e.g. `test/api`). When empty: an existing `test/`, `tests/` or `__tests__/` folder, else `tests/api`; `src/test/java` for Spring."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:prod",
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --production",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "npm run build && tsc -p tsconfig.test.json",
    "test:integration": "vscode-test",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run test:e2e",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "test:e2e:vsix": "npm run package && cross-env API_SHADOW_VSIX=api-shadow-0.3.0.vsix playwright test",
    "screenshots": "npm run package && playwright test -c scripts/screenshots/playwright.config.ts"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "java-parser": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@babel/types": "^7.29.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "extensionKind": [
    "workspace"
  ]
}
